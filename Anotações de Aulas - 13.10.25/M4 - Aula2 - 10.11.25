1. exerciico:

import "./styles.css";
import { getImageUrl } from "./utils";

export default Profile({ name,imageId,awards,discovery}) {
  
  return(
    <section className="profile">
    <h2>{name}</h2>

    <img 
    className="Avatar"
    src={getImageUrl(imageId)}
    alt="name"
    width={70}
    height={70}
  />

  <ul>
  <li>
  <b>Profissão: </b>
 {profissão}
 </li>

 <li>
 <b>Premio: {awards.count} </b>{awards.item.join(",")})
 </li>

 <li>
  <b>Descobertas</b>
  {descovery}
  </li>
  </ul>
  </section>
  );
}


export default function Gallery() {
